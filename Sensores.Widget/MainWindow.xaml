<Window x:Class="Sensores.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitals" Width="236" SizeToContent="Height"
        MinWidth="150" MinHeight="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewMouseLeftButtonDown="Arrastar">

    <Window.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#E8121216"/>
        <SolidColorBrush x:Key="Borda" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Texto" Color="#F2F2F4"/>
        <SolidColorBrush x:Key="Fraco" Color="#7A7A85"/>
        <!-- as legendas estavam a cinzento de rodapé; precisam de contraste para se lerem de relance -->
        <SolidColorBrush x:Key="Legenda" Color="#C3C3D0"/>
        <SolidColorBrush x:Key="Calha" Color="#1EFFFFFF"/>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Legenda}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="Barra" TargetType="Border">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{StaticResource Calha}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- barra de rolagem: fio, não barra -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="pegaDaRolagem">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="corpo" CornerRadius="1" Margin="1,0,0,0"
                                                        Background="#38FFFFFF"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="corpo" Property="Background" Value="#60FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="corpo" Property="Background" Value="#80FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="menuMostrar" Header="Mostrar"/>
            <MenuItem x:Name="menuIntervalo" Header="Intervalo"/>
            <MenuItem x:Name="menuDensidade" Header="Densidade"/>
            <Separator/>
            <MenuItem x:Name="menuTopo" Header="Sempre à frente" IsCheckable="True" IsChecked="True" Click="AlternarTopo"/>
            <MenuItem x:Name="menuArranque" Header="Iniciar com o Windows" IsCheckable="True" Click="AlternarArranque"/>
            <Separator/>
            <MenuItem Header="Copiar leitura" Click="CopiarLeitura"/>
            <MenuItem Header="Sobre o Vitals..." Click="MostrarSobre"/>
            <MenuItem Header="Ajustar ao conteúdo" Click="AjustarAoConteudo"/>
            <MenuItem Header="Repor predefinições" Click="Repor"/>
            <Separator/>
            <MenuItem Header="Esconder junto às horas" Click="Esconder"/>
            <MenuItem Header="Sair" Click="Sair"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="moldura" Background="{StaticResource Fundo}" BorderBrush="{StaticResource Borda}"
            BorderThickness="1" CornerRadius="10" Padding="12,9,12,8">
        <Grid>
            <DockPanel>
                <Grid x:Name="cabecalho" DockPanel.Dock="Top">
                    <TextBlock x:Name="txtNome" FontFamily="Segoe UI Semibold" FontSize="11"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock x:Name="txtAutor" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="9" Foreground="{StaticResource Fraco}"/>
                </Grid>

                <Border x:Name="rodapeCaixa" DockPanel.Dock="Bottom" Margin="0,9,0,0" Padding="0,6,0,0"
                        BorderThickness="0,1,0,0" BorderBrush="{StaticResource Borda}">
                    <Grid>
                        <TextBlock x:Name="txtRodape" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="{StaticResource Fraco}" VerticalAlignment="Center"/>
                        <Ellipse x:Name="pulso" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="5" Height="5" Fill="#86EFAC" Opacity="0.3" Margin="0,0,14,0"/>
                    </Grid>
                </Border>

                <!-- as linhas são construídas em código: uma ou duas colunas conforme a largura,
                     e rola se não couber em altura -->
                <ScrollViewer x:Name="rolagem" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel x:Name="conteudo"/>
                </ScrollViewer>
            </DockPanel>

            <!-- pega de redimensionamento -->
            <Border x:Name="pega" Width="16" Height="16" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Cursor="SizeNWSE" ToolTip="Arrastar para redimensionar"
                    MouseLeftButtonDown="ComecarRedimensionar"
                    MouseMove="AoRedimensionar"
                    MouseLeftButtonUp="AcabarRedimensionar">
                <Path Stroke="#5AFFFFFF" StrokeThickness="1.2" Margin="0,0,1,1"
                      Data="M 15,6 L 6,15 M 15,11 L 11,15"/>
            </Border>
        </Grid>
    </Border>
</Window>
